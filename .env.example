# RPC for everything but the holder snapshot. publicnode has no per-connection limit but refuses getProgramAccounts.
RPC_URL=https://solana-rpc.publicnode.com
# RPC for getProgramAccounts (holder snapshots). Public mainnet-beta works with backoff; a Helius/Chainstack key is better.
SNAPSHOT_RPC_URL=https://api.mainnet-beta.solana.com
# priority fee per compute unit
PRIORITY_MICRO_LAMPORTS=100000
# swap slippage, percent
SLIPPAGE_PCT=5

# the wallet the CLI signs with — bs58 (Phantom export) or a JSON byte array. Never commit it.
PRIVATE_KEY=
# AES-256-GCM key for custodial wallet secrets at rest (64 hex chars). node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=
